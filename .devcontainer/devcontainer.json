{
  "name": "website",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".",
  },

  "mounts": [
    "type=bind,source=${localEnv:SSH_AUTH_SOCK},target=/.ssh-agent.sock,consistency=cached"
  ],

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Website Test",
      "onAutoForward": "openBrowser",
    }
  }
}
